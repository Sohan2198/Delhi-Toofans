# Copy to .env.local (git-ignored) and fill in ONE contact-form backend.
# Values are baked into the build by `npm run build`, so rebuild after changing them.
# If both are empty the site falls back to the legacy Formspark form.

# Option A — Web3Forms (free tier). Get a key at https://web3forms.com by entering the email that should receive
# enquiries; the key arrives by email. The key is designed to be public.
REACT_APP_WEB3FORMS_KEY=
# Optional CC on every enquiry — Web3Forms Pro plans only. Separate several addresses with ";".
REACT_APP_WEB3FORMS_CC=

# Option B — Microsoft 365 Power Automate flow URL. See docs/contact-form-microsoft-365.md.
REACT_APP_CONTACT_FORM_URL=
